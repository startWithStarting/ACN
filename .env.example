# Configuration for ACN

# Path to the configuration file to use
ACN_CONFIG_PATH=config/avoidant_config.yaml

# Postgres connection used by the trace API and ingestion utilities
ACN_DATABASE_URL=postgresql://acn:acn@localhost:5432/acn

# Directory for API-generated plot artifacts from DB-only persisted runs
ACN_ARTIFACT_DIR=results/api_artifacts
