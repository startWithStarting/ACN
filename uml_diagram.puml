@startuml

title ACN Architecture (Updated 2026-05-01)

package "src.agents" {
    class BaseAgent {
        - name: str
        - agent_type: AgentType
        - comms_type: CommsType
        - communication_bandwidth: int
        - processing_capability: int
        - x: float
        - y: float
        - speed: float
        - direction: Tuple[float, float]
        - is_active: bool
        + choose_action(observation)
        + receive_message(sender_name, message_content)
        + send_message(recipient_name, message_content)
    }
    class BlueAgent {
        - detection_radius: float
        - observed_red_agents: Dict
        - prediction_models: Dict
        - max_history_length: int
        - prediction_history: Dict
        - actual_position_history: Dict
        - strategy: str
        + choose_action(observation)
        + record_red_agent_movement(name, position, timestamp)
        + predict_red_positions(red_agent_name)
    }
    class RedAgent {
        - strategy: str
        - strategy_type: str
        + choose_action(observation)
    }
    BaseAgent <|-- BlueAgent
    BaseAgent <|-- RedAgent
}

package "src.agents.strategies" {
    class RedAgentStrategy {
        + center_based_movement_strategy(current_pos, grid_center)
        + avoidant_movement_strategy(current_pos, blue_agents)
        + aggressive_movement_strategy(current_pos, blue_agents)
        + team_based_movement_strategy(current_pos, red_teammates)
        + flocking_movement_strategy(current_pos, red_teammates, params)
    }
    note right of RedAgentStrategy
      Registered via @register_strategy decorator
    end note
}

package "src.agents.blue_strategies" {
    class BlueStrategy {
        + static_strategy(agent, env_state)
        + pursuit_strategy(agent, env_state)
    }
}

package "src.agents.factory" {
    class AgentFactory {
        + create_agents_from_config(agents_config, env_config)
        + create_agent(agent_type, **kwargs)
    }
    AgentFactory --> BlueAgent
    AgentFactory --> RedAgent
}

package "src.agents.registry" {
    class AgentRegistry {
        - _AGENT_REGISTRY: Dict
        - _STRATEGY_REGISTRY: Dict
        + register_agent(agent_type)
        + register_strategy(name, side)
        + create_agent(agent_type, **kwargs)
        + get_strategy(name, side)
        + list_strategies(side)
    }
    AgentRegistry --> BaseAgent
}

package "src.env" {
    class AECGameEnv {
        - agent_objects: Dict
        - possible_agents: list
        + reset()
        + step(action)
        + observe(agent)
        + render()
    }
    class ParallelGameEnv {
        + reset()
        + step(actions)
        + observe(agent)
        + render()
    }
    AECGameEnv <|-- ACNEnvironmentLogic
    ParallelGameEnv <|-- ACNEnvironmentLogic

    class ACNEnvironmentLogic {
        - grid_width: float
        - grid_height: float
        - physics_engine: PhysicsEngine
        - reward_fn: RewardFunction
        - _observation_builder: ObservationBuilder
        - save_episode_gifs: bool
        + _get_observation(agent, step)
        + _calculate_reward(agent)
        + _apply_action(agent, action)
        + _distribute_agents()
        + _reset_agent_positions()
        + render()
    }
    ACNEnvironmentLogic --> ObservationBuilder
    ACNEnvironmentLogic --> RewardFunction
    ACNEnvironmentLogic --> PhysicsEngine
}

package "src.env.observation" {
    class ObservationBuilder {
        + build(agent_obj, step_count)
        + _get_base_observation()
    }
    class BlueObservationBuilder {
        + build(agent_obj, step_count)
    }
    class RedObservationBuilder {
        + build(agent_obj, step_count)
    }
    class FlockingObservationBuilder {
        + build(agent_obj, step_count)
    }
    note right of FlockingObservationBuilder
      Factory: create_observation_builder(agent_type, env)
    end note
    ObservationBuilder <|-- BlueObservationBuilder
    ObservationBuilder <|-- RedObservationBuilder
    RedObservationBuilder <|-- FlockingObservationBuilder
}

package "src.env.rewards" {
    class RewardFunction {
        + __call__(agent_name, agent_obj, env_state)
    }
    class AttractorReward {
        - reward_radius: float
        - tolerance: float
        - blue_passive_reward: float
    }
    class DistanceReward {
        - scale: float
        - max_reward: float
    }
    class DetectionReward {
        - detection_reward: float
        - undetected_penalty: float
    }
    class CompositeReward {
        - reward_fns: List[RewardFunction]
        - weights: List[float]
    }
    note right of CompositeReward
      Factory: create_reward_function(config)
    end note
    RewardFunction <|-- AttractorReward
    RewardFunction <|-- DistanceReward
    RewardFunction <|-- DetectionReward
    RewardFunction <|-- CompositeReward
}

package "src.physics" {
    class PhysicsEngine {
        - _bodies: Dict
        - _obstacles: List
        - _force_fields: List
        - boundary_mode: BoundaryMode
        - grid_width: float
        - grid_height: float
        + register_body(name, position, **kwargs)
        + apply_force(name, force)
        + step(dt)
        + get_position(name)
        + get_velocity(name)
        + set_position(name, position)
        + add_obstacle(obstacle)
        + add_force_field(field)
    }
    class PhysicsBody {
        - position: np.ndarray
        - velocity: np.ndarray
        - acceleration: np.ndarray
        - mass: float
        - max_speed: float
        - max_force: float
        - drag_coefficient: float
        - turning_rate: float
        - radius: float
        - restitution: float
    }
    class BoundaryMode {
        + CLAMP
        + BOUNCE
        + STOP
    }
    PhysicsEngine "1" o-- "*" PhysicsBody
    PhysicsEngine --> BoundaryMode

    package "obstacles" {
        abstract class Obstacle {
            + contains(point)
            + nearest_point(point)
            + normal_at(point)
        }
        class RectObstacle {
            - x, y, width, height
        }
        class CircleObstacle {
            - x, y, radius
        }
        Obstacle <|-- RectObstacle
        Obstacle <|-- CircleObstacle
    }

    package "fields" {
        abstract class ForceField {
            + force_at(position)
        }
        class AttractorField {
            - center: np.ndarray
            - strength: float
        }
        class RepulsorField {
            - center: np.ndarray
            - radius: float
            - strength: float
        }
        class FlowField {
            - direction: np.ndarray
            - strength: float
        }
        ForceField <|-- AttractorField
        ForceField <|-- RepulsorField
        ForceField <|-- FlowField
    }
}

package "src.benchmark" {
    class BenchmarkRunner {
        - scenarios: List[Scenario]
        + run()
        + save_comparison(path)
    }
    class Scenario {
        - name: str
        - env_config: str
        - algorithms: List
        - episodes: int
        - metrics: List
    }
    class MetricsCalculator {
        + avg_episode_reward(episodes)
        + detection_rate(episodes)
        + red_score_rate(episodes)
        + convergence_speed(episodes)
        + calculate_metrics(episodes, names)
    }
    BenchmarkRunner "1" o-- "*" Scenario
}

package "src.training" {
    abstract class BaseTrainer {
        + train(env, timesteps)
        + evaluate(env, episodes)
        + save(path)
        + load(path)
    }
    class Trainer {
        - algorithm: str
        - model: Any
        + train()
        + evaluate()
        + save()
        + load()
    }
    BaseTrainer <|-- Trainer
    Trainer --> ParallelGameEnv
}

package "src.utils" {
    class Logger {
        + get_logger(name)
        + configure_logging(config)
    }
    class GeometryUtils {
        + calculate_distance(pos1, pos2)
        + is_within_detection_radius(center, target, radius)
    }
    class ExperimentUtils {
        + setup_experiment_results_dir()
        + save_prediction_plots()
        + save_timing_stats()
    }
    class ConfigLoader {
        + load_config(path)
    }
    class Tracking {
        + log_metrics(metrics, step)
        + log_episode(data)
        + snapshot_config()
    }
    class Regressor {
        + fit(X, y)
        + predict(X)
    }
}

package "src.communication" {
    abstract class CommunicationModel {
        + process_messages()
        + select_partners()
    }
    class NoCommunicationModel {
    }
    class GNNCommunicationModel {
        - model: Any
    }
    CommunicationModel <|-- NoCommunicationModel
    CommunicationModel <|-- GNNCommunicationModel
}

package "root" {
    class Run {
        + main(mode, config)
    }
    class MainAEC {
        + main(config_path)
    }
    class MainParallel {
        + main(config_path)
    }
    class main
    MainAEC --> AECGameEnv
    MainParallel --> ParallelGameEnv
}

@enduml